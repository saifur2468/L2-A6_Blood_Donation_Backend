model Payment {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  amount        Float
  pdfUrl        String
  transactionId String        @unique
  gateway       String
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([userId, status])
}